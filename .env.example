# Repo-root environment files — filled by ./azure-ai-foundry-classic-chat/infra/scripts/deploy.sh
#
# Per-environment files (recommended):
#   .env.dev   — development (default)
#   .env.prod  — production
#   .env.test  — staging / CI
#
# deploy.sh also copies the active file to .env for local runs.

# --- Active environment (dev | test | prod) ---
ENVIRONMENT_NAME="dev"

# --- Runtime (azure-ai-foundry-classic-chat/chat.py, chat-prompt-flow.py) ---
AZURE_PROJECT_CONNECTION_STRING=""

# Optional: override question for chat-prompt-flow.py
# PROMPT_FLOW_QUESTION="What is a classic Foundry hub?"

# --- Infra names (CAF-style; overwritten by Bicep outputs) ---
RESOURCE_GROUP_NAME="rg-aialearn-dev-eus"
LOCATION="eastus"
COG_SERVICES_ACCOUNT_NAME=""
COG_SERVICES_SKU="S0"
COG_SERVICES_KIND="AIServices"
HUB_NAME=""
PROJECT_NAME=""
AI_SERVICES_CONNECTION_NAME=""

# --- Model ---
DEPLOYMENT_NAME="gpt-5-mini"
MODEL_NAME="gpt-5-mini"
MODEL_VERSION="2025-08-07"
MODEL_FORMAT="OpenAI"
DEPLOYMENT_SKU_NAME="GlobalStandard"
DEPLOYMENT_SKU_CAPACITY="1"
